{
  "ruff-auto-format": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
           "command": ".venv/Scripts/python.exe .agents/hooks/format.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
