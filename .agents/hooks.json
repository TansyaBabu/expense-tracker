{
  "ruff-auto-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe .agents/hooks/format.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}